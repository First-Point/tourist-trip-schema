{
  "name": "tourist-trip-schema",
  "version": "0.1.0",
  "description": "Build valid schema.org TouristTrip JSON-LD for tour itineraries. Zero dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "schema.org",
    "json-ld",
    "structured-data",
    "TouristTrip",
    "itinerary",
    "tour",
    "travel",
    "seo"
  ],
  "author": "Your Next Tours (https://yournext.tours)",
  "license": "MIT",
  "homepage": "https://github.com/First-Point/tourist-trip-schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/First-Point/tourist-trip-schema.git"
  },
  "bugs": {
    "url": "https://github.com/First-Point/tourist-trip-schema/issues"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
